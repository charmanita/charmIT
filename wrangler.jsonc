{
    "name": "charmit",
    "compatibility_date": "2026-05-22",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "workers_dev": true,
    "routes": [
        {
            "pattern": "charmit.charmanita.dev",
            "custom_domain": true
            
        },
        {
            "pattern": "www.charmit.charmanita.dev",
            "custom_domain": true
        }
    ],
    "main": ".svelte-kit/cloudflare/_worker.js",
    "assets": {
        "directory": ".svelte-kit/cloudflare",
        "binding": "ASSETS"
    },
    "observability": {
        "enabled": true
    }
}